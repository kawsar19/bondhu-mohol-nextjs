MONGODB_URI=mongodb://127.0.0.1:27017/bondhu-mohol
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Product name shown on the installed app and browser tab. Each shop's own name is set in Settings.
NEXT_PUBLIC_APP_NAME=

# Used only by `npm run seed:admin` to create or reset an admin account (new shops: `npm run create:shop`)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@bondhumohol.com
ADMIN_PASSWORD=

# Address printed in table QR codes, e.g. https://bondhumohol.com
NEXT_PUBLIC_SITE_URL=

# Used only by `npm run seed:superadmin` to create the platform owner's account (/platform)
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
